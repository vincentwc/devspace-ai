APP_ENV=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Debug (Model) 必填；留空则 make run / Debug(Fake) 走 Fake Model
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
# openai_compatible | fake；Debug 脚本也会按 --mode 覆盖
MODEL_PROVIDER=

MAX_TEXT_CHARS=50000
MAX_UPLOAD_BYTES=1048576
DEFAULT_MAX_CASES=10
HARD_MAX_CASES=30
MODEL_TIMEOUT_SECONDS=120
TOTAL_TIMEOUT_SECONDS=150

# 本地 compose 映射主机 55432→容器 5432；CI 仍用 5432 并注入本变量
DATABASE_URL=postgresql+psycopg://devspace:devspace@localhost:55432/devspace_ai
# 留空或不设置：按 APP_ENV 推断（local/test 开，prod 关）；也可显式 true/false
# ENABLE_DEBUG_UI=
