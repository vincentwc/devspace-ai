  "cards": [
    {
      "dot": "cyan",
      "title": "主路径 Graph",
      "items": [
        "POST /api/v1/case-drafts/generate：ingest → generate → validate（可 repair 一次）→ persist",
        "GET /runs/{run_id} 回查同一条 Run；草稿需人工确认后才进入业务用例库"
      ]
    },
    {
      "dot": "emerald",
      "title": "模型与数据",
      "items": [
        "无 MODEL_API_KEY 或 MODEL_PROVIDER=fake 时不出站；有密钥才调用 Chat Completions",
        "generation_runs 瘦表：run_id / status / input_text + payload JSONB"
      ]
    },
    {
      "dot": "rose",
      "title": "信任边界（v1）",
      "items": [
        "无鉴权、不写 TMS、无独立 SPA；Debug UI 仅 local/test 默认开启，生产关闭",
        "GET /health 只探进程；GET /ready 对 PostgreSQL 执行 SELECT 1，失败返回 503"
      ]
    }
